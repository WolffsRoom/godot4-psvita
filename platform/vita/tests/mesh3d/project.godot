config_version=5

[application]
config/name="Vita GXM 3D Probe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=544
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.08, 1)

[threading]
worker_pool/max_threads=2
