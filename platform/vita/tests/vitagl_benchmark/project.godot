; Renderer benchmark for the GXM (libvita2d) vs VitaGL bridge A/B.
; Same project in both VPKs; only eboot.bin differs.
config_version=5

[application]
config/name="Vita Renderer Benchmark"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=544
window/stretch/mode="canvas_items"
; Uncapped: with vsync both bridges would just report 60 FPS.
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.08, 1)
vita/tilt_shift=false
vita/vertex_lighting=true
; Keep the adaptive triangle budget out of the way (it reacts to CPU time).
vita/triangle_budget=200000

[threading]
worker_pool/max_threads=2
