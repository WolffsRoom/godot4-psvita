; GXM3D test scene (Tux) and benchmark: animated Sprite3D/Label3D, vertex
; tint and sorted transparency on the native GXM 3D renderer.
; Everything is procedural: no imported textures, meshes or fonts.
config_version=5

[application]
config/name="GXM3D Feature Test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=544
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.075, 1)
vita/tilt_shift=false
vita/vertex_lighting=true
vita/triangle_budget=200000

[threading]
worker_pool/max_threads=2
